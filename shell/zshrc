# Disable software flow control (i.e. <ctrl>-s and <ctrl>-q)
stty -ixon

# 10ms for key sequences (default is 400)
KEYTIMEOUT=1

# vi-style line editing (replaces oh-my-zsh vi-mode plugin)
bindkey -v

# rm * without asking for confirmation
setopt rmstarsilent

# History (INC_APPEND + SHARE are required for tmux panes that stay open)
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt EXTENDED_HISTORY
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_SAVE_NO_DUPS
setopt HIST_FIND_NO_DUPS

# Prefer US English and use UTF-8
export LC_ALL="en_US.UTF-8"
export LANG="en_US.UTF-8"

# Set default editor
export EDITOR='vim'

# By default, zsh considers many characters part of a word (e.g., _ and -).
# Narrow that down to allow easier skipping through words via M-f and M-b.
export WORDCHARS='*?[]~&;!$%^<>'

## re-bind zsh backwards search (vi mode unbinds these by default)
bindkey '^[[A' up-line-or-search
bindkey '^[[B' down-line-or-search
bindkey '^[[3~' delete-char
bindkey '^R' history-incremental-search-backward
bindkey '^W' backward-kill-word    # vi-backward-kill-word
bindkey '^H' backward-delete-char  # vi-backward-delete-char
bindkey '^K' kill-line             # vi-kill-line
bindkey '^U' backward-kill-line
bindkey '^?' backward-delete-char  # vi-backward-delete-char
bindkey '^A' beginning-of-line
bindkey '^E' end-of-line
bindkey '^F' forward-word
bindkey '^B' backward-word

# use v to launch edit command in vi command mode
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey -M vicmd 'v' edit-command-line

# Load and run compinit
autoload -U compinit
ZSH_COMPDUMP="${XDG_CACHE_HOME:-$HOME/.cache}/zcompdump-${HOST}-${ZSH_VERSION}"
compinit -i -d "${ZSH_COMPDUMP}"

# commands, aliases, settings
. $HOME/.aliases
. $HOME/.functions
. $HOME/.paths

# Load machine-specific env vars
if [ -d "$HOME/.env" ]; then
  for i in $HOME/.env/*.sh ; do source $i ; done
fi

# Setup pure theme
fpath+=$HOME/.zsh/pure
autoload -U promptinit; promptinit

# Pure prints a leading newline before every prompt. Skip it on the first
# prompt (new window/pane); keep spacing between commands.
__pure_first_prompt=1
print() {
  if (( $# == 0 )) && [[ ${funcstack[2]:-} == prompt_pure_preprompt_render ]]; then
    if (( __pure_first_prompt )); then
      __pure_first_prompt=0
    else
      builtin print
    fi
  else
    builtin print "$@"
  fi
}

clear() {
  __pure_first_prompt=1
  command clear "$@"
}

prompt pure
