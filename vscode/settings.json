{
    "editor.minimap.enabled": false,
    "workbench.editor.wrapTabs": true,
    "vim.handleKeys": {
        "<C-f>": false,
        "<C-a>": false,
        "<C-c>": false,
        "<C-v>": false,
        "<C-x>": false,
        "<C-z>": false,
        "<C-n>": false
    },
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": ["L"],
            "after": [],
            "commands": [
                {
                    "command": "workbench.action.nextEditor",
                    "args": []
                }
            ]
        },{
            "before": ["H"],
            "after": [],
            "commands": [
                {
                    "command": "workbench.action.previousEditor",
                    "args": []
                }
            ]
        }
    ],
}